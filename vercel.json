{
  "version": 2,
  "functions": {
    "api/comments.py": { "runtime": "python3.11", "memory": 1024, "maxDuration": 10 },
    "app.py": { "runtime": "python3.11", "memory": 1024, "maxDuration": 10 }
  },
  "routes": [
    { "src": "/api/comments", "dest": "/api/comments.py" },
    { "src": "/(.*)", "dest": "/app.py" }
  ]
}
